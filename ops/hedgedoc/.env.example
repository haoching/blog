HEDGE_DOC_DOMAIN=edit.chang929.site
HEDGE_DOC_DB_PASSWORD=replace-with-long-random-value
PUBLISHER_DB_PASSWORD=replace-with-long-random-value
HEDGE_DOC_SESSION_SECRET=replace-with-at-least-64-random-characters
HEDGE_DOC_GITHUB_CLIENT_ID=replace-me
HEDGE_DOC_GITHUB_CLIENT_SECRET=replace-me
