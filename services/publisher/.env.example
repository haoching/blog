PORT=3000
HEDGE_DOC_URL=http://hedgedoc:3000
HEDGE_DOC_DOMAIN=edit.chang929.site
DATABASE_URL=postgres://publisher:change-me@database:5432/publisher

# Preferred: GitHub App credentials. The App library mints and refreshes
# short-lived installation tokens automatically.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem

# Optional bootstrap fallback. Leave empty when the GitHub App is configured.
GITHUB_TOKEN=
GITHUB_OWNER=haoching
GITHUB_REPO=blog
GITHUB_BRANCH=master

R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=blog-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://media.chang929.site

CF_ACCESS_TEAM_DOMAIN=https://YOUR-TEAM.cloudflareaccess.com
CF_ACCESS_AUDIENCE=
REQUIRE_ACCESS=true
