{
  "name": "blog-publisher",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build",
    "dev": "node --watch dist/server.js",
    "build": "tsc -p tsconfig.json",
    "migrate:existing": "node dist/migrate-existing.js",
    "pretest": "tsc -p tsconfig.test.json",
    "start": "node dist/server.js",
    "test": "node --test dist-test/test/validation.test.js dist-test/test/hedgedoc-syntax.test.js dist-test/test/images.test.js dist-test/test/publication.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1107.0",
    "fastify": "5.11.3",
    "gray-matter": "4.0.3",
    "jose": "6.1.0",
    "octokit": "5.0.5",
    "pg": "8.16.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/pg": "8.15.5",
    "typescript": "5.9.2"
  }
}
